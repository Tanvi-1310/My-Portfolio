# Flask Environment Configuration
# Copy this file to .env for local development overrides.
# NEVER commit the real .env file or real secrets to Git.

# Secret Key for cryptographic session signing and form security
SECRET_KEY=your-secure-random-secret-key-here

# Database Connection URI (defaults to local SQLite in instance/portfolio.db if unset)
# SQLite example: sqlite:///instance/portfolio.db
# PostgreSQL example: postgresql://user:password@localhost:5432/portfolio
DATABASE_URL=sqlite:///instance/portfolio.db

# Flask Debug Mode (0 = disabled/production, 1 = enabled/local development)
FLASK_DEBUG=0

# Port configuration (optional, defaults to 5000)
PORT=5000
